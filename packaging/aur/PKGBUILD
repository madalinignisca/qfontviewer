# Maintainer: Madalin Ignisca <git@madalin.me>
pkgname=qfontviewer
pkgver=1.0.0
pkgrel=1
pkgdesc="Minimal Qt6 font viewer with a console-rendering preview (links only qt6-base)"
arch=('x86_64')
url="https://github.com/madalinignisca/qfontviewer"
license=('GPL-3.0-or-later')
depends=('qt6-base')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Replace with the real checksum after tagging the release:  updpkgsums
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    qmake6 PREFIX=/usr
    make
}

package() {
    cd "$pkgname-$pkgver"
    make install INSTALL_ROOT="$pkgdir"
}
