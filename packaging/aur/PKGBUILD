# Maintainer: Madalin Ignisca <git@madalin.me>
pkgname=qfontviewer
pkgver=1.1.0
pkgrel=1
pkgdesc="Minimal Qt6 font viewer with a console-rendering preview (links only qt6-base)"
arch=('x86_64')
url="https://github.com/madalinignisca/qfontviewer"
license=('GPL-3.0-or-later')
depends=('qt6-base')
makedepends=('cmake')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('4433058ea2503359b9a1df0e7b16aabaaa4450212c12df151808b6c399956e9b')

build() {
    cmake -B build -S "$pkgname-$pkgver" \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=None \
        -DBUILD_TESTING=OFF \
        -Wno-dev
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
