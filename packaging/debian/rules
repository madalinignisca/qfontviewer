#!/usr/bin/make -f
# qfontviewer builds with CMake; debhelper auto-detects the cmake buildsystem
# (CMakeLists.txt at the package root) and handles CMAKE_INSTALL_PREFIX=/usr and
# DESTDIR. Tests are disabled for the package build.

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_TESTING=OFF
