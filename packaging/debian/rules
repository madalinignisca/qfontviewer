#!/usr/bin/make -f
# qfontviewer builds with Qt6's qmake (qmake6). We invoke qmake6 explicitly
# rather than rely on a qmake debhelper buildsystem (the stock one targets Qt5),
# so the build is unambiguous across debhelper versions. dh's makefile
# buildsystem then drives the build via "make" once the Makefile exists.

%:
	dh $@

override_dh_auto_configure:
	qmake6 PREFIX=/usr

override_dh_auto_install:
	make install INSTALL_ROOT=$(CURDIR)/debian/qfontviewer
